{
  "name": "senior-qa-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Supplycart Senior QA assessment: Playwright UI, API, debugging and risk analysis",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:q1": "playwright test --project=q1",
    "test:report": "allure run -- npm test",
    "report": "allure generate allure-results",
    "report:open": "allure open allure-report",
    "check": "npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "allure": "3.18.0",
    "allure-playwright": "3.12.2",
    "prettier": "3.6.2",
    "zod": "4.1.12"
  }
}

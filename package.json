{
  "name": "senior-qa-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Supplycart Senior QA assessment: Playwright UI, API, debugging and risk analysis",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "report": "allure run --open -- npm test",
    "demo": "PW_DEMO=1 allure run --open -- npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "allure": "3.18.0",
    "allure-playwright": "3.12.2",
    "prettier": "3.6.2",
    "zod": "4.1.12"
  }
}

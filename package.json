{
  "name": "senior-qa-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Supplycart Senior QA assessment: Playwright UI, API, debugging and risk analysis",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=debugging --project=ui-chromium --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:q1": "playwright test --project=debugging",
    "test:guards": "playwright test --project=framework-guards",
    "test:security": "playwright test --project=security-api --project=security-ui",
    "test:perf": "playwright test --project=performance",
    "test:cross-browser": "playwright test --project=ui-firefox --project=ui-webkit",
    "demo": "playwright test --project=ui-chromium --headed --workers=1 --grep TC15",
    "demo:inspect": "playwright test --project=ui-chromium --ui",
    "report": "playwright show-report",
    "check": "npm run typecheck && npm run test:guards && npm test",
    "cleanup": "node scripts/cleanup.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  }
}

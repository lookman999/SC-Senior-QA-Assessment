# Optional shell variables; this file is documentation, not automatically loaded.
BASE_URL=https://automationexercise.com
WORKERS=1
# Explicit proxy only when your network needs one; no credentials in this file.
# PW_PROXY_SERVER=http://proxy.example:8080
# Opt-in failure traces contain synthetic credentials and cookies. Keep private.
CAPTURE_TRACE=0
# Optional ad-host blocking changes the measured experience; default is off.
BLOCK_ADS=0
# Optional installed Chrome for a headed demonstration; record the browser used.
# PW_CHANNEL=chrome
# PW_EXECUTABLE_PATH is reserved for a verified local browser binary override.
# Optional lab latency check: report-only without an agreed budget.
# API_P95_BUDGET_MS=2000
